# Copy this file to .env and fill the values before running the bot

# Discord application client ID (overrides hardcoded fallback)
CLIENT_ID=your-client-id-here

# Discord bot token
BOT_TOKEN=your-bot-token-here

# Local SQLite database path
DATABASE_PATH=./src/dal/database/database.sqlite

# Optional yt-dlp executable path. Leave unset when yt-dlp is on PATH
# Windows example: YT_DLP_COMMAND=C:/tools/yt-dlp.exe
YT_DLP_COMMAND=

# Optional runtime settings
NODE_ENV=development

# Timezone for cron jobs and date handling (IANA name recommended, e.g. Europe/London).
# If not set, the app will use the system-resolved timezone and then fall back to GMT.
TZ=Europe/Dublin
