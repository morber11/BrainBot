{
    "name": "brain-bot",
    "version": "2.6.3",
    "description": "Brain Brain Brain Brain Brain Brain",
    "main": "./src/index.js",
    "scripts": {
        "start": "node ./src/index.js",
        "test": "mocha \"src/tests/**/*.test.js\" --require test/setup.js --exit",
        "db-sync": "node ./src/dal/database/sync-db.js",
        "db-run-migrations": "node ./src/dal/database/migrator.js",
        "test-multiple": "powershell -Command \"1..10 | ForEach-Object { npm run test; if ($LASTEXITCODE -ne 0) { Write-Host 'Test failed!'; exit 1 } }\"",
        "brain": "git pull && chmod +x ./build-and-deploy.sh && ./build-and-deploy.sh",
        "lint": "eslint \"src/**/*.js\" --max-warnings=0",
        "lint:fix": "eslint \"src/**/*.js\" --fix"
    },
    "engines": {
        "node": ">=18"
    },
    "author": "morber",
    "license": "ISC",
    "overrides": {
        "uuid": "^11.1.1"
    },
    "dependencies": {
        "@discordjs/voice": "^0.19.2",
        "@distube/ytdl-core": "^4.16.12",
        "cron": "^3.5.0",
        "discord.js": "^14.27.0",
        "dotenv": "^8.6.0",
        "node-opus": "^0.3.3",
        "sequelize": "^6.37.8",
        "sqlite3": "^6.0.1",
        "tweetnacl": "^1.0.3",
        "ytdl-core": "^4.11.5",
        "ytdl-core-discord": "^1.3.1"
    },
    "devDependencies": {
        "sequelize-cli": "^6.6.5",
        "nodemon": "^3.1.14",
        "mocha": "^10.2.0",
        "chai": "^4.3.7",
        "sinon": "^15.1.0",
        "sinon-chai": "^3.7.0",
        "proxyquire": "^2.1.3",
        "eslint": "^8.48.0"
    }
}
